+++ b/internal/ceres/local_gradient_norm_probe.h
@@ -0,0 +1,38 @@
+#ifndef CERES_INTERNAL_LOCAL_GRADIENT_NORM_PROBE_H_
+#define CERES_INTERNAL_LOCAL_GRADIENT_NORM_PROBE_H_
+#include "ceres/internal/export.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+namespace ceres::internal {
+using LocalGradientNormProbeClassifierV1=bool(*)(const void*);
+extern "C" CERES_EXPORT LocalGradientNormProbeClassifierV1 RinkfitCeresSetLocalNormProbeClassifierV1(LocalGradientNormProbeClassifierV1);
+extern "C" CERES_EXPORT bool RinkfitCeresLocalNormProbeAllowedV1(const void*);
+struct LocalGradientNormProbeResult {
+ bool valid=false,conservative=false;double max_norm=0,norm=0,local_max_norm=0,local_norm=0,scale=1;int rejected_probes=0;
+};
+// Preserve the original unit gradient mapping whenever it is defined. Only
+// an explicitly registered local chart may backtrack a norm probe. A smaller
+// mapping is diagnostic, not an upper bound on the unit mapping: any unit
+// failure disables this evaluation's gradient-tolerance termination.
+template<class Plus,class Domain>
+LocalGradientNormProbeResult LocalGradientNormProbe(const double*x,int ambient,const double*gradient,int tangent,double*delta,double*projected,const Plus&plus,const Domain&domain){
+ LocalGradientNormProbeResult out;double raw_max=0;for(int j=0;j<tangent;++j){if(!std::isfinite(gradient[j]))return out;raw_max=std::max(raw_max,std::abs(gradient[j]));}for(int i=0;i<ambient;++i)if(!std::isfinite(x[i]))return out;
+ double minimum_scale=0;
+ for(;;){for(int j=0;j<tangent;++j)delta[j]=-out.scale*gradient[j];bool valid=plus(x,delta,projected);double largest=0,norm=0;
+  if(valid)for(int i=0;i<ambient;++i){if(!std::isfinite(projected[i])){valid=false;break;}const double d=x[i]-projected[i];largest=std::max(largest,std::abs(d));norm=std::hypot(norm,d);}
+  if(valid){out.valid=true;out.local_max_norm=largest/out.scale;out.local_norm=norm/out.scale;if(out.rejected_probes){out.conservative=true;out.max_norm=out.norm=std::numeric_limits<double>::max();}else{out.max_norm=largest;out.norm=norm;}return out;}
+  ++out.rejected_probes;
+  if(out.rejected_probes==1){
+   // Domain verifies that no unrelated manifold failed and maps this exact
+   // tangent direction through the original PlusJacobian, without residuals.
+   if(!domain(delta,projected))return out;minimum_scale=std::numeric_limits<double>::infinity();
+   for(int i=0;i<ambient;++i){if(!std::isfinite(projected[i]))return out;const double a=std::abs(projected[i]);if(a>0)minimum_scale=std::min(minimum_scale,64*std::numeric_limits<double>::epsilon()*std::max(1.,std::abs(x[i]))/a);}
+   if(!std::isfinite(minimum_scale)||!(raw_max>0))return out;
+  }
+  const double next=out.rejected_probes==1?std::min(.5,1./std::max(1.,raw_max)):out.scale*.5;
+  if(!(next>minimum_scale)||next==out.scale)return out;out.scale=next;
+ }
+}
+}
+#endif
