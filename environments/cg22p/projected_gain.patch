+  bool Minus(const double* y, const double* x, double* y_minus_x) const final {
+    std::atomic<bool> abort(false);
+    const auto& blocks = program_->parameter_blocks();
+    ParallelFor(options_.context, 0, blocks.size(), options_.num_threads,
+                [&](int block_id) {
+      if (abort) return;
+      const auto* block = blocks[block_id];
+      if (block->TangentSize() == 0) return;
+      const double* bx = x + block->state_offset();
+      const double* by = y + block->state_offset();
+      double* bd = y_minus_x + block->delta_offset();
+      if (const auto* manifold = block->manifold()) {
+        if (!manifold->Minus(by, bx, bd)) abort = true;
+      } else {
+        VectorRef(bd, block->Size()) =
+            ConstVectorRef(by, block->Size()) - ConstVectorRef(bx, block->Size());
+      }
+    });
+    return !abort;
+  }
