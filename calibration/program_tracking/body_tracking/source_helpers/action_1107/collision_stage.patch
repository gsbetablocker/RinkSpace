+def mesh_rows(ref,state,x,t,geometry):
+    capsules,boxes,labels=geometry
+    selected={}
+    for lo,hi,pair in RECHECK:
+        for tick in range(round(100*lo),round(100*hi)+1):
+            selected.setdefault(tick,set()).add(pair)
+    out=[]
+    for tick,pairs in sorted(selected.items()):
+        seconds=tick/100.
+        times=np.array([seconds-t[0]])
+        d=state.increments(x[17:],times)
+        body=fk_state(ref,ref.at(times),d)
+        parts=parts_for_sample(ref,body,capsules,boxes,labels,{k for pair in pairs for k in pair})
+        for a,b in sorted(pairs):
+            out.append(dict(seconds=seconds,pair=[a,b],triangles=triangle_crossings(parts[a],parts[b])))
+    return out
+
+def local_source_guard(p):
+    body=p.body
+    frames=body.frames[body.of]
+    sec=body.reference.p['pts'][frames]/12800.
+    j=body.oj
+    uv=body.cache['uv'][body.of,body.layout.body_landmarks[body.model_oj]]
+    err=np.linalg.norm(uv-body.obs['uv'][frames,j],axis=1)
+    result={}
+    for lo,hi in RANGES:
+        for group,inds in [('torso',[5,6,11,12]),('legs',[13,14,15,16])]:
+            mask=(sec>=lo)&(sec<=hi)&np.isin(j,inds)
+            if mask.any():result[f'{lo:.2f}/{group}']=float(np.percentile(err[mask],95))
+    return result
