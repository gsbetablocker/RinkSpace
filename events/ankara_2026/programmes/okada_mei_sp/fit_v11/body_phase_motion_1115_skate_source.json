  "phase_basis": "81.62–81.74 为落冰后支撑尚在稳定的过渡。81.74 附近胸背朝下并朝镜头，81.98 背向镜头，82.22 转至相反朝向，82.46 重现此前近端朝向。82.70 含周期后的延续。起落的精确接触点、受力和刃侧未知。",
  "source_roles": "fit 仅用于本轮方向；1115 的保护区域仍为开发约束。additional_check 完全留在评估文件中，禁止进入方向、整体目标、选择或阈值。相邻源曝光不当作独立器材标定。",
  "unknown_segments": [
    {
      "scope": "80.92–81.18 free skate",
      "reason": "右自由鞋出平面旋转，运动拖影呈带状，前后端不稳定；使用历史开发保护点，未登记朝向。"
    },
    {
      "scope": "81.30–81.52 two skates",
      "reason": "原片可核对连续亮带及鞋的大致方向转动，多个曝光前后端重叠，只登记位置宽区间。81.40 检测踝槽混合，按原片腿链判断。"
    },
    {
      "scope": "81.72–82.46 free skate",
      "reason": "与裙摆、手臂和背景重叠，部分侧面可以跟踪区域，端点及刃侧未知。"
    },
    {
      "scope": "81.74–82.46 supporting skate",
      "reason": "见低位鞋来回转过四分之一周，正面或背面不强行标方向；源侧脚跟和鞋端确实可见时才给弦。"
    },
    {
      "scope": "77.88–78.14 shoes",
      "reason": "双腿在快速空转中重叠，没有可信逐曝光刃侧或独立朝向。"
    }
  ],
